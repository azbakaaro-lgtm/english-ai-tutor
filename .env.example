# Copy this file to .env.local if you want to connect the frontend to the
# optional free backend in /backend. Leave it unset (or delete .env.local)
# to run in pure Demo Mode, where everything is stored in the browser via
# localStorage and no server is required at all.

# URL of the backend API (see /backend/README or /backend/.env.example).
# Example: VITE_API_URL=http://localhost:5050
VITE_API_URL=
