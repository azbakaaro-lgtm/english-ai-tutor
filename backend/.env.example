# Copy this file to .env and adjust as needed. Everything here is free —
# no paid API keys are required anywhere in this project.

# Port the backend server listens on
PORT=5050

# Secret used to sign JWT auth tokens. Change this to a long random string
# before deploying anywhere other than your own machine.
JWT_SECRET=change-this-to-a-long-random-string

# Which frontend origin(s) may call this API. Use * for local development,
# or your deployed frontend URL in production (e.g. https://your-app.com).
CORS_ORIGIN=*

# --- Admin access ---
# Comma-separated list of email addresses that become Admin the moment they
# register (or next time they log in). Set this to YOUR email before you
# register, then log in — you'll automatically get access to /app/admin.
# Example: ADMIN_EMAILS=you@example.com,teacher@example.com
ADMIN_EMAILS=

# --- Optional AI quick-fill (NOT required — you can write all content by hand) ---
# The Admin Dashboard's lesson editor works fully without this: you type
# lessons, vocabulary, reading and listening content directly in the admin
# UI, save as draft, and publish — no AI, no API key, no payment involved.
#
# If you ever want an optional "quick-fill" starting point, there's a
# built-in free template generator that needs no setup at all. For a
# higher-quality AI-written starting point instead, you may optionally get
# a free API key (no credit card) at https://console.groq.com/keys and
# paste it below — but this is entirely optional and OFF by default.
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
